
# Action half (Slack-gated remediation). Read from env, never hardcoded.
SLACK_BOT_TOKEN=          # xoxb-... (chat:write); unset -> outbound dry-run
SLACK_APP_TOKEN=          # xapp-... (connections:write) for Socket Mode inbound
SLACK_SIGNING_SECRET=     # required for /slack/interact; unset -> route fails closed
SLACK_CHANNEL_ID=         # target channel for briefs
SLACK_DRY_RUN=1           # 1 = log payloads instead of posting (dev)
ACTION_APPROVAL_TTL_S=3600
ACTION_WEB_SECRET=        # shared secret header for the web-approve fallback (dev)
